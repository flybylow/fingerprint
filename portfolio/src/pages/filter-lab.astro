---
import { getImage } from 'astro:assets';
import workshop from '../content/work/electrolux/workshop.jpg';
import cover from '../content/work/electrolux/cover.png';

const shots = await Promise.all(
  [
    {
      src: workshop,
      label: 'Workshop — photo',
      alt: 'Electrolux workshop: people in a room, with a lot of color. The discovery photograph.',
    },
    {
      src: cover,
      label: 'Cover — UI',
      alt: 'Electrolux case study: a screenshot of the interface.',
    },
  ].map(async (shot) => ({
    ...shot,
    image: await getImage({
      src: shot.src,
      width: shot.src.width,
      height: shot.src.height,
      format: 'webp',
      quality: 90,
    }),
  })),
);

const variants = [
  {
    id: 'current',
    index: '01',
    name: 'Current',
    tech: 'grayscale(1); ::after #FF5D22; opacity 0.72; mix-blend-mode: soft-light',
    tag: 'Too heavy',
    note: 'The veil blankets the photograph and the interface.',
  },
  {
    id: 'veil',
    index: '02',
    name: 'Lighter veil',
    tech: 'grayscale(1); ::after #FF5D22; opacity 0.35; mix-blend-mode: soft-light',
    tag: 'Elegant',
    note: 'Same blend, quiet enough that faces and UI still read.',
  },
  {
    id: 'highlights',
    index: '03',
    name: 'Highlights only',
    tech: 'grayscale(1); ::after #FF5D22; opacity 0.28; mix-blend-mode: overlay',
    tag: 'Elegant',
    note: 'Shadows stay dark. Orange sits in the lights, including bright UI panels.',
  },
  {
    id: 'warm',
    index: '04',
    name: 'Warm gray',
    tech: 'filter: grayscale(1) sepia(0.28) saturate(0.9) — no overlay',
    tag: 'Elegant',
    note: 'Almost no orange, just warmth. Type and UI edges stay crisp.',
  },
  {
    id: 'signal',
    index: '05',
    name: 'Signal in the dark',
    tech: 'SVG #signal-dark — shadows map near #0A0A0B, highlights toward #FFB38A',
    tag: 'Elegant',
    note: 'Recommended direction, not applied live. Midtones stay readable; the UI loses its own colors but keeps its shapes.',
  },
  {
    id: 'edge',
    index: '06',
    name: 'Edge only',
    tech: 'grayscale(1); 1px #FF5D22 rule along the bottom, fading to transparent',
    tag: 'Elegant',
    note: 'Orange never covers the picture, so the UI is not tinted.',
  },
  {
    id: 'breath',
    index: '07',
    name: 'Breath',
    tech: 'grayscale(1); soft-light #FF5D22 opacity 0.18–0.42 over 8s. Reduced motion: 0.28',
    tag: 'Elegant',
    note: 'A slow pulse. The peak stays lighter than Current.',
  },
  {
    id: 'reveal',
    index: '08',
    name: 'Reveal',
    tech: 'Starts as Signal in the dark. Hover, or Open, fades it off in 500ms.',
    tag: 'Elegant',
    note: 'Muted until you ask. Original color returns — the same idea as the live interaction.',
    reveal: true,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0A0A0B" />
    <title>Filter lab</title>
  </head>
  <body>
    <svg class="defs" aria-hidden="true" focusable="false">
      <defs>
        <filter id="signal-dark" color-interpolation-filters="sRGB" x="0" y="0" width="100%" height="100%">
          <feColorMatrix
            in="SourceGraphic"
            type="matrix"
            result="gray"
            values="0.2126 0.7152 0.0722 0 0
                    0.2126 0.7152 0.0722 0 0
                    0.2126 0.7152 0.0722 0 0
                    0 0 0 1 0"></feColorMatrix>
          <feComponentTransfer in="gray" result="curve">
            <feFuncR type="table" tableValues="0 0.05 0.18 0.38 0.58 0.75 0.88 1"></feFuncR>
            <feFuncG type="table" tableValues="0 0.05 0.18 0.38 0.58 0.75 0.88 1"></feFuncG>
            <feFuncB type="table" tableValues="0 0.05 0.18 0.38 0.58 0.75 0.88 1"></feFuncB>
          </feComponentTransfer>
          <feColorMatrix
            in="curve"
            type="matrix"
            values="0.20426 0.68715 0.06937 0 0.03922
                    0.14090 0.47400 0.04785 0 0.03922
                    0.10588 0.35620 0.03596 0 0.04314
                    0 0 0 1 0"></feColorMatrix>
        </filter>
      </defs>
    </svg>

    <main class="lab">
      <header class="intro">
        <h1>Filter lab</h1>
        <p>
          This is a lab for judging image treatments. It is not the live site, and nothing here is applied
          to the portfolio.
        </p>
        <p>
          Each cell runs one treatment on both pictures: the Electrolux workshop photograph, and the
          case-study interface. A real shader can do this duotone, but SVG/CSS already can, and a canvas
          shader would be more machinery than the photo needs.
        </p>
      </header>

      <div class="grid">
        {
          variants.map((variant, variantIndex) => (
            <section
              class:list={['cell', variant.reveal && 'cell-reveal']}
              aria-labelledby={`${variant.id}-title`}
            >
              <div class="cell-copy">
                <p class="index">{variant.index}</p>
                <h2 id={`${variant.id}-title`}>{variant.name}</h2>
                <p class="tech">{variant.tech}</p>
                <p class="verdict">
                  <span class="tag">{variant.tag}</span> {variant.note}
                </p>
                {variant.reveal && (
                  <button type="button" class="open" aria-pressed="false" data-reveal>
                    Open
                  </button>
                )}
              </div>
              <div class="pair">
                {shots.map((shot, shotIndex) => (
                  <figure>
                    <div class:list={['stage', `stage-${variant.id}`]}>
                      <img
                        src={shot.image.src}
                        width={shot.image.attributes.width}
                        height={shot.image.attributes.height}
                        alt={shot.alt}
                        decoding="async"
                        loading={variantIndex === 0 && shotIndex === 0 ? 'eager' : 'lazy'}
                      />
                      {variant.reveal && (
                        <img
                          class="treat"
                          src={shot.image.src}
                          width={shot.image.attributes.width}
                          height={shot.image.attributes.height}
                          alt=""
                          decoding="async"
                        />
                      )}
                    </div>
                    <figcaption>{shot.label}</figcaption>
                  </figure>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </main>

    <script is:inline>
      document.querySelectorAll('[data-reveal]').forEach((button) => {
        button.addEventListener('click', () => {
          const cell = button.closest('.cell-reveal');
          if (!cell) return;
          const open = cell.classList.toggle('is-open');
          button.setAttribute('aria-pressed', String(open));
          button.textContent = open ? 'Close' : 'Open';
        });
      });
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
  }

  body {
    margin: 0;
    background: #0a0a0b;
    color: #f5f3f0;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    line-height: 1.5;
  }

  .defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .lab {
    box-sizing: border-box;
    width: min(72rem, calc(100% - 2rem));
    margin: 0 auto;
    padding: 3.5rem 0 5rem;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(2rem, 1.5rem + 2vw, 3.1rem);
    font-weight: 520;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .intro p {
    max-width: 40rem;
    margin: 0.9rem 0 0;
    color: #9a968f;
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .grid {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
  }

  .cell {
    padding: 1.15rem;
    background: #141416;
    border: 1px solid rgba(245, 243, 240, 0.09);
    border-radius: 8px;
  }

  .cell-copy {
    max-width: 46rem;
  }

  .index {
    margin: 0;
    color: #9a968f;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  h2 {
    margin: 0.2rem 0 0;
    font-size: 1.35rem;
    font-weight: 520;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .tech {
    margin: 0.45rem 0 0;
    color: #9a968f;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .verdict {
    margin: 0.45rem 0 0;
    color: #f5f3f0;
    font-size: 0.95rem;
    line-height: 1.45;
  }

  .tag {
    color: #ffb38a;
  }

  .open {
    margin-top: 0.85rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid rgba(245, 243, 240, 0.18);
    border-radius: 999px;
    background: transparent;
    color: #f5f3f0;
    font: inherit;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .open:hover {
    border-color: rgba(255, 179, 138, 0.7);
  }

  .open:focus-visible {
    outline: 1px solid #ffb38a;
    outline-offset: 3px;
  }

  .pair {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  @media (min-width: 800px) {
    .lab {
      width: min(72rem, calc(100% - 4rem));
      padding-top: 4.5rem;
    }

    .cell {
      padding: 1.35rem 1.35rem 1.2rem;
    }

    .pair {
      grid-template-columns: 1fr 1fr;
      gap: 0.9rem;
    }
  }

  figure {
    margin: 0;
  }

  .stage {
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: #0a0a0b;
    line-height: 0;
  }

  .stage img {
    display: block;
    width: 100%;
    height: auto;
  }

  .stage-current img,
  .stage-veil img,
  .stage-highlights img,
  .stage-edge img,
  .stage-breath img {
    filter: grayscale(1);
  }

  .stage-warm img {
    filter: grayscale(1) sepia(0.28) saturate(0.9);
  }

  .stage-signal img {
    filter: url(#signal-dark);
  }

  .stage-current::after,
  .stage-veil::after,
  .stage-highlights::after,
  .stage-breath::after,
  .stage-edge::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .stage-current::after,
  .stage-veil::after,
  .stage-highlights::after,
  .stage-breath::after {
    inset: 0;
    background: #ff5d22;
  }

  .stage-current::after {
    opacity: 0.72;
    mix-blend-mode: soft-light;
  }

  .stage-veil::after {
    opacity: 0.35;
    mix-blend-mode: soft-light;
  }

  .stage-highlights::after {
    opacity: 0.28;
    mix-blend-mode: overlay;
  }

  .stage-edge::after {
    right: 0;
    bottom: 0;
    left: 0;
    height: 1px;
    background: linear-gradient(90deg, #ff5d22 0%, #ff5d22 62%, transparent 100%);
  }

  .stage-breath::after {
    opacity: 0.18;
    mix-blend-mode: soft-light;
    animation: breath 8s ease-in-out infinite;
  }

  .stage-reveal .treat {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: url(#signal-dark);
    transition: opacity 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .cell-reveal .pair:hover .treat,
  .cell-reveal.is-open .treat {
    opacity: 0;
  }

  figcaption {
    margin-top: 0.45rem;
    color: #9a968f;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  @keyframes breath {
    0%,
    100% {
      opacity: 0.18;
    }
    50% {
      opacity: 0.42;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-breath::after {
      animation: none;
      opacity: 0.28;
    }

    .stage-reveal .treat {
      transition: none;
    }
  }
</style>
