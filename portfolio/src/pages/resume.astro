---
import ContactLink from '@/components/ui/ContactLink.astro';
import Icon from '@/components/ui/Icon.astro';
import PageHero from '@/components/ui/PageHero.astro';
import { resume } from '@/config/resume';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profileSchema } from '@/lib/schema';
import { url } from '@/lib/url';
---

<BaseLayout
  title="Resume"
  description={`${siteConfig.author.name}'s experience, capabilities, education, and tools across two decades of product design and front-end.`}
  type="profile"
  structuredData={profileSchema(url('/resume/'))}
>
  <PageHero eyebrow={resume.eyebrow} title={resume.title} highlight={resume.highlight} text={resume.text}>
    <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-step: 3">
      {siteConfig.resumePdf && (
        <a class="btn btn-primary" href={siteConfig.resumePdf} download>
          <Icon name="download" class="size-4" />
          Download PDF
        </a>
      )}
      <ContactLink
        kind="mail"
        value={siteConfig.author.email}
        reveal
        class:list={['btn', siteConfig.resumePdf ? 'btn-ghost' : 'btn-accent']}
      >
        <Icon slot="icon" name="arrow-up-right" class="icon-nudge-diagonal size-4" />
      </ContactLink>
    </div>
  </PageHero>

  <div class="shell mt-20 sm:mt-28">
    <section class="resume-row reveal" aria-labelledby="snapshot-title">
      <h2 id="snapshot-title" class="eyebrow self-start">
        Snapshot
      </h2>
      <dl class="grid gap-x-10 gap-y-6 sm:grid-cols-2">
        {resume.snapshot.map((item) => (
          <div>
            <dt class="meta">{item.label}</dt>
            <dd class="mt-1 text-lg font-medium">
              {item.contact ? (
                <ContactLink kind={item.contact} value={item.value} reveal />
              ) : (
                item.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="resume-row reveal" aria-labelledby="experience-title">
      <h2 id="experience-title" class="eyebrow self-start">
        Experience
      </h2>
      <ol class="grid gap-10">
        {resume.experience.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[minmax(0,1fr)_auto] sm:gap-x-8">
            <h3 class="text-title">
              <span class="text-accent">{job.role}</span><span class="text-muted">, {job.company}</span>
            </h3>
            <p class="text-sm text-muted sm:row-start-1 sm:col-start-2 sm:pt-1.5">{job.period}</p>
            <p class="max-w-2xl text-body">{job.text}</p>
            {job.points && (
              <ul class="max-w-2xl list-disc space-y-1 pl-5 text-body sm:col-span-2">
                {job.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ol>
    </section>

    <section class="resume-row reveal" aria-labelledby="capabilities-title">
      <h2 id="capabilities-title" class="eyebrow self-start">
        Capabilities
      </h2>
      <ul class="grid gap-8 sm:grid-cols-3">
        {resume.capabilities.map((item) => (
          <li>
            <h3 class="text-title">{item.title}</h3>
            <p class="mt-2 text-muted">{item.text}</p>
          </li>
        ))}
      </ul>
    </section>

    {resume.education.length > 0 && (
    <section class="resume-row reveal" aria-labelledby="education-title">
      <h2 id="education-title" class="eyebrow self-start">
        Education
      </h2>
      <ul class="grid gap-6">
        {resume.education.map((item) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-8 gap-y-1">
            <span>
              <span class="font-medium">{item.title}</span>
              {item.place && <span class="text-muted">, {item.place}</span>}
            </span>
            {item.period && <span class="text-sm text-muted">{item.period}</span>}
          </li>
        ))}
      </ul>
    </section>
    )}

    {resume.tools.length > 0 && (
    <section class="resume-row reveal" aria-labelledby="tools-title">
      <h2 id="tools-title" class="eyebrow self-start">
        Tools
      </h2>
      <ul class="flex flex-wrap gap-2">
        {resume.tools.map((tool) => (
          <li class="rounded-full border border-line px-3 py-1.5 text-sm">{tool}</li>
        ))}
      </ul>
    </section>
    )}

    {resume.languages.length > 0 && (
    <section class="resume-row reveal" aria-labelledby="languages-title">
      <h2 id="languages-title" class="eyebrow self-start">
        Languages
      </h2>
      <ul class="grid gap-y-4 sm:grid-cols-2 sm:gap-x-16 lg:gap-x-24">
        {resume.languages.map((language) => (
          <li class="flex items-baseline justify-between gap-6 border-b border-line pb-3">
            <span class="font-medium">{language.name}</span>
            <span class="text-sm text-muted">{language.level}</span>
          </li>
        ))}
      </ul>
    </section>
    )}
  </div>
</BaseLayout>

<style>
  .resume-row {
    display: grid;
    gap: 1.5rem;
    padding-block: 3rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .resume-row {
      grid-template-columns: 16rem minmax(0, 1fr);
      gap: 4rem;
    }
  }
</style>
