---
import ThemeToggle from '@/components/chrome/ThemeToggle.astro';
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { navigation, siteConfig } from '@/config/site';
import { url } from '@/lib/url';

const path = Astro.url.pathname;
const current = (href: string) => {
  const full = url(href);
  if (href === '/') return path === full || path === full.replace(/\/$/, '') ? 'page' : undefined;
  return path === full ? 'page' : path.startsWith(full) ? 'true' : undefined;
};
---

<header class="site-header sticky top-0 z-40 h-(--header-h) border-b border-transparent bg-canvas">
  <div class="shell flex h-full items-center gap-4">
    <a href={url('/')} class="brand">
      <Logomark />
      <span class="brand-copy">
        <span class="brand-name">{siteConfig.name}</span>
        <span class="brand-role">{siteConfig.author.role}</span>
      </span>
      <span class="sr-only">, home</span>
    </a>

    <nav aria-label="Main" class="ml-auto hidden md:block">
      <ul class="flex items-center gap-1">
        {navigation
          .filter((link) => link.href !== '/resume/')
          .map((link) => (
            <li>
              <a href={url(link.href)} class="nav-link" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>

    <div class="ml-auto flex items-center gap-1.5 md:ml-2">
      <ThemeToggle />
      <a
        class="btn btn-primary btn-sm ml-1 hidden sm:inline-flex"
        href={url(siteConfig.action.href)}
        download={siteConfig.action.download}
      >
        <Icon name="download" class="size-4" />
        {siteConfig.action.label}
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full hover:bg-sunken md:hidden"
        commandfor="mobile-nav"
        command="show-modal"
        aria-haspopup="dialog"
        aria-label="Menu"
      >
        <Icon name="menu" class="size-5" />
      </button>
    </div>
  </div>

  <dialog id="mobile-nav" aria-label="Menu" class="mobile-nav md:hidden">
    <div class="shell flex h-(--header-h) items-center justify-between">
      <a href={url('/')} class="brand">
        <Logomark />
        <span class="brand-copy">
          <span class="brand-name">{siteConfig.name}</span>
          <span class="brand-role">{siteConfig.author.role}</span>
        </span>
        <span class="sr-only">, home</span>
      </a>
      <button
        type="button"
        class="grid size-10 place-items-center rounded-full hover:bg-sunken"
        commandfor="mobile-nav"
        command="close"
        aria-label="Close menu"
      >
        <Icon name="x" class="size-5" />
      </button>
    </div>
    <nav aria-label="Mobile" class="shell mt-4">
      <ul class="grid">
        {navigation
          .filter((link) => link.href !== '/resume/')
          .map((link) => (
            <li>
              <a href={url(link.href)} class="mobile-link" aria-current={current(link.href)}>
                {link.label}
              </a>
            </li>
          ))}
      </ul>
    </nav>
    <div class="shell mt-8">
      <a class="btn btn-primary w-full" href={url(siteConfig.action.href)} download={siteConfig.action.download}>
        <Icon name="download" class="size-4" />
        {siteConfig.action.label}
      </a>
    </div>
  </dialog>
</header>

<script>
  const menu = document.getElementById('mobile-nav') as HTMLDialogElement | null;

  if (menu && !('command' in HTMLButtonElement.prototype)) {
    document.querySelectorAll<HTMLButtonElement>('[commandfor="mobile-nav"]').forEach((button) => {
      button.addEventListener('click', () =>
        button.getAttribute('command') === 'close' ? menu.close() : menu.showModal(),
      );
    });
  }

  menu?.addEventListener('click', (event) => {
    if ((event.target as Element).closest('a')) menu.close();
  });
  matchMedia('(min-width: 48rem)').addEventListener('change', (event) => event.matches && menu?.close());
</script>

<style>
  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-line linear both;
      animation-timeline: scroll(root);
      animation-range: 0 4rem;
    }
  }

  @keyframes header-line {
    to {
      border-bottom-color: var(--line);
    }
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    border-radius: 0.5rem;
  }

  .brand-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.05rem;
  }

  .brand-name {
    font-size: 1.15rem;
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.15;
    white-space: nowrap;
  }

  .brand-role {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: -0.01em;
    line-height: 1.15;
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .brand-copy {
      flex-direction: row;
      align-items: baseline;
      gap: 0.7rem;
    }

    .brand-role {
      font-size: 0.8125rem;
    }
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.95rem;
    font-weight: 500;
    transition: color 160ms ease;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .nav-link[aria-current] {
    color: var(--ink);
  }

  .nav-link[aria-current]::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.38rem;
    width: 0.85rem;
    height: 1.5px;
    border-radius: 999px;
    background: var(--accent);
    transform: translateX(-50%);
  }

  .mobile-nav {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 2rem;
    border: 0;
    background: var(--canvas);
    color: var(--ink);
  }

  .mobile-link {
    display: flex;
    align-items: center;
    min-height: 3.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 1.75rem;
    font-weight: 500;
    letter-spacing: -0.03em;
  }

  .mobile-link[aria-current] {
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
    padding-left: 0.85rem;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mobile-nav {
      transition:
        opacity 220ms ease,
        translate 320ms var(--ease-out-expo),
        display 320ms allow-discrete,
        overlay 320ms allow-discrete;
    }

    .mobile-nav:not([open]) {
      opacity: 0;
      translate: 0 -0.75rem;
    }

    @starting-style {
      .mobile-nav[open] {
        opacity: 0;
        translate: 0 -0.75rem;
      }
    }
  }
</style>
