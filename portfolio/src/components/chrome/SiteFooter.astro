---
import ContactLink from '@/components/ui/ContactLink.astro';
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { closing } from '@/config/home';
import { legalLinks, navigation, siteConfig } from '@/config/site';
import { socialIcon } from '@/lib/socials';
import { url } from '@/lib/url';

interface Props {
  closing?: boolean;
}

const { closing: showClosing = true } = Astro.props;
const { email } = siteConfig.author;
const year = new Date().getFullYear();
---

{showClosing && (
  <section class="closing" aria-labelledby="closing-title">
    <div class="shell">
      <div class="signal-card closing-card reveal">
        <div class="relative">
          <p class="eyebrow">{closing.eyebrow}</p>
          <h2 id="closing-title" class="mt-4 max-w-[22ch] text-title">
            {closing.title} <span class="serif-accent">{closing.highlight}</span>
          </h2>
          <p class="mt-3 max-w-md text-muted">{closing.text}</p>
          <div class="mt-6 flex flex-wrap items-center gap-4">
            <ContactLink kind="mail" value={email} reveal class="btn btn-accent btn-sm">
              <Icon slot="icon" name="arrow-up-right" class="icon-nudge-diagonal size-4" />
            </ContactLink>
            <a class="closing-link" href={url('/resume/')}>
              View resume
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
)}

<footer class="mt-24 border-t border-line sm:mt-32">
  <div class="shell grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div>
      <a href={url('/')} class="inline-flex items-center gap-2.5 text-[1.15rem] font-medium tracking-[-0.03em]">
        <Logomark />
        <span>{siteConfig.name}</span>
        <span class="sr-only">, home</span>
      </a>
      <p class="mt-5 max-w-xs text-muted">
        {siteConfig.author.role}. Industrial systems, ML interfaces, and products built end to end.
      </p>
    </div>

    <nav aria-labelledby="footer-pages">
      <h2 id="footer-pages" class="meta">
        Pages
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {navigation.map((link) => (
          <li>
            <a class="footer-link" href={url(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-elsewhere">
      <h2 id="footer-elsewhere" class="meta">
        Elsewhere
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {siteConfig.socials.map((social) => (
          <li>
            <a class="footer-link inline-flex items-center gap-2.5" href={social.href} rel="me noopener">
              <Icon name={socialIcon(social.label)} class="size-3.5 text-muted" />
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-legal">
      <h2 id="footer-legal" class="meta">
        Legal
      </h2>
      <ul class="mt-4 grid gap-2.5">
        {legalLinks.map((link) => (
          <li>
            <a class="footer-link" href={url(link.href)}>
              {link.label}
            </a>
          </li>
        ))}
        {siteConfig.cookieConsent.enabled && (
          <li>
            <button type="button" class="footer-link text-left" data-cookie-preferences data-needs-js>
              Cookie preferences
            </button>
          </li>
        )}
      </ul>
    </nav>
  </div>

  <div class="shell flex flex-wrap items-center justify-between gap-4 border-t border-line py-6 text-sm text-muted">
    <p>
      &copy; {year} {siteConfig.author.name}. All rights reserved.
    </p>
    <a href="#content" class="link inline-flex items-center gap-1.5">
      Back to top
      <Icon name="arrow-up" class="size-3.5" />
    </a>
  </div>
</footer>

<style>
  .closing {
    padding-block: 6.5rem;
  }

  .closing + footer {
    margin-top: 0;
  }

  .closing-card {
    width: min(100%, 48rem);
    margin-inline: auto;
    padding: 2rem 1.5rem;
  }

  @media (min-width: 40rem) {
    .closing {
      padding-block: 9rem;
    }

    .closing-card {
      padding: 2.25rem 2rem;
    }
  }

  .footer-link,
  .closing-link {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    transition:
      color 160ms ease,
      text-decoration-color 160ms ease;
  }

  .footer-link:hover,
  .closing-link:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }
</style>
