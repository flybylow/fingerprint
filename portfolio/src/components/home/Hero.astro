---
import Icon from '@/components/ui/Icon.astro';
import BlobAvatar from '@/components/home/BlobAvatar.astro';
import { hero } from '@/config/home';
import { url } from '@/lib/url';
---

<section class="shell pt-14 pb-20 sm:pt-20 sm:pb-28 lg:pt-24" aria-labelledby="hero-title">
  <div class="hero-head">
    <div class="hero-blob rise" style="--rise-step: 0"><BlobAvatar size={220} /></div>
    <div class="hero-content">
  <h1 id="hero-title" class="rise max-w-[16ch] text-headline" style="--rise-step: 1">
    {hero.greeting ? `${hero.greeting} ` : ''}
    {hero.title} <span class="serif-accent">{hero.highlight}</span>
  </h1>

  <div class="mt-10 grid gap-12 lg:mt-14 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-end">
    <div class="rise" style="--rise-step: 2">
      <p class="signal-sub max-w-xl">{hero.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn hero-cta" href={url(hero.primary.href)}>
          {hero.primary.label}
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
      </div>
    </div>

    <dl class="facts rise" style="--rise-step: 3">
      {hero.facts.map((fact) => (
        <div>
          <dd class="fact-value">{fact.value}</dd>
          <dt class="meta fact-label">{fact.label}</dt>
        </div>
      ))}
    </dl>
  </div>
    </div>
  </div>
</section>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(3, 8.75rem);
    column-gap: 1.5rem;
    align-items: start;
    margin: 0;
  }

  .fact-value {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem);
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .hero-cta {
    border-color: var(--line);
    background: transparent;
    color: var(--muted);
    font-weight: 500;
  }

  .hero-cta:hover {
    border-color: color-mix(in srgb, var(--ink) 22%, var(--line));
    background: transparent;
    color: var(--ink);
  }

  .fact-label {
    margin-top: 0.7rem;
    white-space: nowrap;
  }

  .hero-head { display: flex; align-items: flex-start; gap: 2.5rem; }
  .hero-blob { margin-top: 0.75rem; }
  .hero-content { flex: 1 1 auto; min-width: 0; }
  .hero-blob { flex: 0 0 auto; }
  @media (max-width: 820px) {
    .hero-head { flex-direction: column; align-items: flex-start; gap: 1.5rem; }
  }
</style>
