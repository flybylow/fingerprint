---
import SectionHead from '@/components/ui/SectionHead.astro';
import { ai } from '@/config/home';
---

<section id="ai" class="shell mt-20 sm:mt-28" aria-labelledby="ai-title">
  <SectionHead id="ai-title" eyebrow={ai.eyebrow} title={ai.title} text={ai.text} />
  <ul class="ai-grid mt-10">
    {ai.items.map((item, i) => (
      <li class="ai-item reveal">
        <span class="ai-index">{String(i + 1).padStart(2, '0')}</span>
        <h3 class="mt-3 text-title">{item.title}</h3>
        <p class="mt-1 text-muted">{item.text}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .ai-grid {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .ai-item {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 768px) {
    .ai-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 0 2.5rem;
      border-top: none;
    }
    .ai-item {
      border-bottom: none;
      border-top: 2px solid var(--accent);
      padding: 1rem 0 0;
    }
  }
  .ai-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--accent);
  }
</style>
