---
import SectionHead from '@/components/ui/SectionHead.astro';
import { minor } from '@/config/minor';
---

<section id="smaller" class="shell mt-20 sm:mt-28" aria-labelledby="smaller-title">
  <SectionHead id="smaller-title" eyebrow={minor.eyebrow} title={minor.title} text={minor.text} />
  <ul class="minor-list mt-10">
    {minor.items.map((item) => (
      <li class="minor-row reveal">
        <div class="minor-body">
          <h3 class="text-title">{item.title}</h3>
          <p class="mt-1 text-muted">{item.text}</p>
        </div>
        {item.tag && <span class="minor-tag">{item.tag}</span>}
      </li>
    ))}
  </ul>
</section>

<style>
  .minor-list {
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }
  .minor-row {
    display: grid;
    gap: 0.5rem 1.5rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }
  @media (min-width: 640px) {
    .minor-row {
      grid-template-columns: 1fr auto;
      align-items: baseline;
    }
  }
  .minor-tag {
    justify-self: start;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--accent, #ff5d22);
    border: 1px solid color-mix(in srgb, var(--accent, #ff5d22) 35%, transparent);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
    white-space: nowrap;
  }
  @media (min-width: 640px) {
    .minor-tag { justify-self: end; }
  }
</style>
