---
import Icon from '@/components/ui/Icon.astro';
import { minor } from '@/config/minor';
import { url } from '@/lib/url';
---

<section id="smaller" class="shell mt-20 sm:mt-28" aria-labelledby="smaller-title">
  <h2 id="smaller-title" class="text-section">{minor.title}</h2>
  <div class="minor-board mt-10">
    <div class="minor-names" role="radiogroup" aria-label="Experiments">
      {
        minor.items.map((item, index) => (
          <>
            <input
              class="minor-radio"
              type="radio"
              name="experiment"
              id={`experiment-${index}`}
              checked={index === 0}
            />
            <label class="minor-name" for={`experiment-${index}`}>
              <span class="minor-num">{String(index + 1).padStart(2, '0')}</span>
              <span>{item.title}</span>
            </label>
          </>
        ))
      }
    </div>
    {
      minor.items.map((item, index) => {
        const shots =
          item.images ??
          (item.image
            ? [{ src: item.image, alt: item.imageAlt ?? '', position: item.imagePosition, fit: item.imageFit }]
            : []);
        const links =
          item.links ??
          (item.href ? [{ href: item.href, label: item.linkLabel ?? item.title, external: item.external }] : []);
        return (
          <article class="minor-panel" id={`experiment-panel-${index}`}>
            <h3 class="minor-title">{item.title}</h3>
            <div class="minor-copy">
              <p class="minor-line">{item.line}</p>
              {item.text && <p class="minor-text">{item.text}</p>}
              {links.length > 0 && (
                <div class="minor-links">
                  {links.map((link) => (
                    <a
                      class="minor-external"
                      href={link.external ? link.href : url(link.href)}
                      {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {link.label}
                      {link.external && <Icon name="arrow-up-right" class="size-3.5" />}
                      {link.external && <span class="sr-only">, external site</span>}
                    </a>
                  ))}
                </div>
              )}
            </div>
            {shots.length > 0 && (
              <div class:list={['minor-shots', { 'is-pair': shots.length === 2, 'is-trio': shots.length > 2 }]}>
                {shots.map((shot) => (
                  <img src={url(shot.src)} alt={shot.alt} />
                ))}
              </div>
            )}
          </article>
        );
      })
    }
  </div>
</section>

<style>
  .minor-board {
    display: grid;
    grid-template-columns: minmax(12.5rem, 16rem) minmax(0, 1fr);
    gap: 1.25rem 2.75rem;
    align-items: start;
  }

  .minor-names {
    display: flex;
    flex-direction: column;
    border-bottom: 1px solid var(--line);
  }

  .minor-radio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .minor-name {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.85rem 0 0.85rem 0.15rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.3;
    cursor: pointer;
  }

  .minor-num {
    flex-shrink: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
  }

  .minor-radio:focus-visible + .minor-name {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .minor-radio:checked + .minor-name {
    color: var(--ink);
    box-shadow: inset 2px 0 0 var(--accent);
    padding-left: 0.7rem;
  }

  .minor-panel {
    display: none;
    min-width: 0;
  }

  .minor-board:has(#experiment-0:checked) #experiment-panel-0,
  .minor-board:has(#experiment-1:checked) #experiment-panel-1,
  .minor-board:has(#experiment-2:checked) #experiment-panel-2,
  .minor-board:has(#experiment-3:checked) #experiment-panel-3,
  .minor-board:has(#experiment-4:checked) #experiment-panel-4,
  .minor-board:has(#experiment-5:checked) #experiment-panel-5 {
    display: block;
  }

  .minor-shots {
    position: relative;
    width: fit-content;
    max-width: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface);
  }

  .minor-shots::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--accent);
    opacity: 0.18;
    mix-blend-mode: soft-light;
    pointer-events: none;
    animation: breath 8s ease-in-out infinite;
  }

  .minor-shots.is-pair,
  .minor-shots.is-trio {
    display: grid;
    width: 100%;
    grid-template-columns: 1fr 1fr;
    gap: 2px;
  }

  .minor-shots.is-trio img:first-child {
    grid-column: 1 / -1;
  }

  .minor-shots.is-pair:has(img[style*='object-position']) {
    grid-template-columns: 1fr;
  }

  .minor-shots img {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: min(32rem, 70vh);
    object-fit: contain;
    filter: grayscale(1);
    transition: filter 450ms ease;
  }

  @media (hover: hover) {
    .minor-shots:hover img {
      filter: none;
    }

    .minor-shots:hover::after {
      animation: none;
      opacity: 0;
    }
  }

  @keyframes breath {
    0%,
    100% {
      opacity: 0.18;
    }
    50% {
      opacity: 0.42;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .minor-shots::after {
      animation: none;
      opacity: 0.28;
    }

    .minor-shots:hover::after {
      opacity: 0;
    }
  }

  .minor-title {
    margin-bottom: 0.55rem;
    font-size: var(--text-title);
    font-weight: 500;
    letter-spacing: var(--text-title--letter-spacing);
    line-height: var(--text-title--line-height);
  }

  .minor-copy {
    max-width: 40rem;
    margin-bottom: 1.15rem;
  }

  .minor-line {
    margin-top: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.45;
  }

  .minor-text {
    margin-top: 0.35rem;
    font-size: 1rem;
    line-height: 1.45;
  }

  .minor-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: 0.9rem;
  }

  .minor-external {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .minor-external:hover {
    color: var(--accent);
  }

  @media (max-width: 699px) {
    .minor-board {
      grid-template-columns: 1fr;
    }

    .minor-shots img {
      max-height: min(24rem, 62vh);
    }
  }
</style>
