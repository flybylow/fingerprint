---
import { clientWork } from '@/config/clients';
import { url } from '@/lib/url';

const srcOf = (image: string | { src: string }) => (typeof image === 'string' ? url(image) : image.src);
---

<section class="shell mt-20 sm:mt-28" data-older-work aria-labelledby="client-work-title">
  <h2 id="client-work-title" class="text-section">{clientWork.title}</h2>
  <ul class="client-cards">
    {
      clientWork.items.map((item) => (
        <li>
          <button type="button" data-older-open>
            <span class="client-shot">
              <img src={srcOf(item.image)} alt={item.imageAlt} style={`object-position: ${item.imagePosition}`} />
            </span>
            <span class="client-copy">
              <span class="client-name">{item.title}</span>
              <span class="client-line">{item.line}</span>
            </span>
          </button>
        </li>
      ))
    }
  </ul>
  <dialog class="older-lightbox" data-older-lightbox>
    <form method="dialog" class="older-lightbox-bar">
      <button type="submit" class="older-lightbox-close" value="close">Close</button>
    </form>
    <img alt="" />
  </dialog>
</section>

<script is:inline>
  if (!window.__olderWork) {
    window.__olderWork = true;

    document.addEventListener('click', (event) => {
      const opener = event.target.closest('[data-older-open]');
      if (opener) {
        const dialog = document.querySelector('[data-older-lightbox]');
        const source = opener.querySelector('img');
        const picture = dialog && dialog.querySelector('img');
        if (!dialog || !source || !picture) return;
        picture.src = source.currentSrc || source.src;
        picture.alt = source.alt;
        if (dialog.parentElement !== document.body) document.body.appendChild(dialog);
        if (!dialog.open) dialog.showModal();
        return;
      }

      if (event.target.matches?.('[data-older-lightbox]')) event.target.close();
    });
  }
</script>

<style>
  .client-cards {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 1.5rem 0 0;
    padding: 0.5rem 0.35rem 0.35rem;
    list-style: none;
  }

  .client-cards li {
    width: min(100%, 16.5rem);
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
    transform: rotate(var(--tilt));
    transition: transform 220ms var(--ease-out-expo);
  }

  .client-cards li:nth-child(1) {
    --tilt: -0.8deg;
  }

  .client-cards li:nth-child(2) {
    --tilt: 0.55deg;
    margin-top: 0.7rem;
  }

  .client-cards li:nth-child(3) {
    --tilt: -0.3deg;
  }

  .client-cards button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .client-cards button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .client-shot {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .client-shot::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--accent);
    opacity: 0.18;
    mix-blend-mode: soft-light;
    pointer-events: none;
    animation: breath 8s ease-in-out infinite;
  }

  .client-cards img {
    display: block;
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    background: var(--sunken);
    filter: grayscale(1);
    transition: filter 450ms ease;
  }

  @media (hover: hover) {
    .client-cards li:hover img {
      filter: none;
    }

    .client-cards li:hover .client-shot::after {
      animation: none;
      opacity: 0;
    }
  }

  @keyframes breath {
    0%,
    100% {
      opacity: 0.18;
    }
    50% {
      opacity: 0.42;
    }
  }

  .client-copy {
    display: block;
    padding: 0.75rem 0.9rem 0.9rem;
  }

  .client-name {
    display: block;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .client-line {
    display: block;
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.35;
  }

  .client-cards li:hover {
    transform: rotate(0deg) translateY(-3px);
  }

  .older-lightbox {
    width: min(68rem, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    margin: auto;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
  }

  .older-lightbox::backdrop {
    background: rgb(0 0 0 / 0.97);
    cursor: pointer;
  }

  .older-lightbox-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.6rem;
  }

  .older-lightbox-close {
    border: 0;
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    padding: 0.35rem 0.8rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .older-lightbox img {
    display: block;
    max-width: 100%;
    max-height: calc(100vh - 5.5rem);
    width: auto;
    height: auto;
    margin-inline: auto;
    border-radius: var(--radius-card);
    background: var(--surface);
    object-fit: contain;
  }

  @media (prefers-reduced-motion: reduce) {
    .client-cards li,
    .client-cards li:hover {
      transform: none;
      transition: none;
    }

    .client-shot::after {
      animation: none;
      opacity: 0.28;
    }

    .client-cards li:hover .client-shot::after {
      opacity: 0;
    }
  }
</style>
