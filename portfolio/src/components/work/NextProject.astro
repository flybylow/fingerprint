---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { projectHref, type Project } from '@/lib/work';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { client, title, cover, tint } = project.data;
---

<aside class="shell mt-24 sm:mt-32" aria-labelledby="next-project">
  <div class="next-card relative grid overflow-hidden rounded-card border border-line bg-surface md:grid-cols-2">
    <div class="flex flex-col justify-between gap-10 p-7 sm:p-10">
      <p id="next-project" class="eyebrow">
        Next case study
      </p>
      <div>
        <p class="font-medium text-muted">{client}</p>
        <p class="mt-2 text-title">
          <a href={projectHref(project)} class="after:absolute after:inset-0 focus-visible:outline-none">
            {title}
          </a>
        </p>
        <span class="btn btn-primary btn-sm mt-8" aria-hidden="true">
          Read case study
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </span>
      </div>
    </div>
    <div class="next-frame tint-panel relative min-h-64 overflow-hidden" style={`--tint: ${tint}`}>
      <Image
        src={cover}
        alt=""
        widths={[640, 960, 1280, 1600]}
        sizes="(min-width: 80rem) 50rem, (min-width: 48rem) 65vw, 130vw"
        quality={90}
        class="next-shot shot absolute top-[14%] left-[10%] w-[130%] max-w-none"
      />
    </div>
  </div>
</aside>

<style>
  .next-card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .next-shot {
      transform-origin: 0 0;
      transition:
        scale 700ms var(--ease-out-expo),
        filter 450ms ease;
    }
  }

  .next-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    opacity: 0.18;
    mix-blend-mode: soft-light;
    pointer-events: none;
    animation: breath 8s ease-in-out infinite;
  }

  .next-shot {
    filter: grayscale(1);
  }

  @media (hover: hover) {
    .next-card:hover .next-shot,
    .next-card:has(a:focus-visible) .next-shot {
      filter: none;
    }

    .next-card:hover .next-frame::after,
    .next-card:has(a:focus-visible) .next-frame::after {
      animation: none;
      opacity: 0;
    }
  }

  @keyframes breath {
    0%,
    100% {
      opacity: 0.18;
    }
    50% {
      opacity: 0.42;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .next-frame::after {
      animation: none;
      opacity: 0.28;
    }

    .next-card:hover .next-frame::after,
    .next-card:has(a:focus-visible) .next-frame::after {
      opacity: 0;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .next-card:hover .next-shot {
      scale: 1.04;
    }

    .next-card:hover .icon-nudge {
      transform: translateX(3px);
    }
  }
</style>
