---
import { Image } from 'astro:assets';
import Icon from '@/components/ui/Icon.astro';
import { projectHref, type Project } from '@/lib/work';

interface Props {
  project: Project;
  /** The first cards on a page load eagerly. */
  eager?: boolean;
  headingLevel?: 'h2' | 'h3';
  /** Service chips under the title. Off on the homepage. */
  showServices?: boolean;
}

const { project, eager = false, headingLevel: Heading = 'h3', showServices = true } = Astro.props;
const { title, client, year, services, cover, coverAlt, tint } = project.data;
---

<article class="project-card reveal relative" style={`--tint: ${tint}`}>
  <Heading class="text-title">
    <a href={projectHref(project)} class="after:absolute after:inset-0 focus-visible:outline-none">
      {title}
    </a>
  </Heading>
  <div class="mt-2 flex items-center justify-between gap-4 text-sm text-muted">
    <span class="font-medium text-ink">{client}</span>
    <span class="meta">{year}</span>
  </div>
  {showServices && services.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Services">
      {services.slice(0, 3).map((service) => (
        <li class="chip">{service}</li>
      ))}
    </ul>
  )}
  <div class="project-frame tint-panel relative mt-5 aspect-5/4 overflow-hidden rounded-card">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="(min-width: 80rem) 44rem, (min-width: 48rem) 55vw, 110vw"
      quality={90}
      loading={eager ? 'eager' : 'lazy'}
      class="project-shot shot absolute inset-0 h-full w-full object-cover object-center"
    />
    <span
      class="project-badge absolute top-5 right-5 grid size-11 place-items-center rounded-full bg-accent text-on-accent"
      aria-hidden="true"
    >
      <Icon name="arrow-up-right" class="size-5" />
    </span>
  </div>
</article>

<style>
  .project-card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 8px;
    border-radius: var(--radius-card);
  }

  .project-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--accent);
    opacity: 0.18;
    mix-blend-mode: soft-light;
    pointer-events: none;
    animation: breath 8s ease-in-out infinite;
  }

  .project-shot {
    filter: grayscale(1);
  }

  .project-badge {
    z-index: 2;
    opacity: 0;
    scale: 0.6;
  }

  @media (hover: hover) {
    .project-card:hover .project-shot,
    .project-card:has(a:focus-visible) .project-shot {
      filter: none;
    }

    .project-card:hover .project-frame::after,
    .project-card:has(a:focus-visible) .project-frame::after {
      animation: none;
      opacity: 0;
    }
  }

  .project-card:hover .project-badge,
  .project-card:has(a:focus-visible) .project-badge {
    opacity: 1;
    scale: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .project-shot {
      transform-origin: center;
      transition:
        scale 700ms var(--ease-out-expo),
        filter 450ms ease;
    }

    .project-badge {
      transition:
        opacity 250ms ease,
        scale 450ms var(--ease-out-expo);
    }

    @media (hover: hover) {
      .project-card:hover .project-shot {
        scale: 1.04;
      }
    }
  }

  @keyframes breath {
    0%,
    100% {
      opacity: 0.18;
    }
    50% {
      opacity: 0.42;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-frame::after {
      animation: none;
      opacity: 0.28;
    }

    .project-card:hover .project-frame::after,
    .project-card:has(a:focus-visible) .project-frame::after {
      opacity: 0;
    }
  }
</style>
