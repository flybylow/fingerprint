    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "tailwindcss": "4.3.3",
    "concurrently": "^9.2.1",
